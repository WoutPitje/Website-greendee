{
  "kind": "collectionType",
  "collectionName": "references",
  "info": {
    "singularName": "reference",
    "pluralName": "references",
    "displayName": "Referentie",
    "description": "Uitgevoerde projecten van GreenDee"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "location": {
      "type": "string",
      "required": true
    },
    "capacity": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Energiehandel",
        "Netcongestie",
        "Energie-optimalisatie",
        "Elektrificatie"
      ],
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Gerealiseerd",
        "In ontwikkeling"
      ],
      "default": "Gerealiseerd",
      "required": true
    },
    "projectStatus": {
      "type": "enumeration",
      "enum": [
        "Gerealiseerd",
        "In ontwikkeling"
      ],
      "default": "Gerealiseerd",
      "description": "Vervangt het veld status. In Strapi 5 is \"status\" een gereserveerde naam (naast documentId, locale en publishedAt), waardoor dat veld wel te lezen maar niet meer op te slaan was."
    },
    "specs": {
      "type": "string",
      "description": "Extra systeemspecificaties naast de batterij, bijvoorbeeld PV en laadinfrastructuur"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageIsLogo": {
      "type": "boolean",
      "default": false,
      "description": "Aanvinken bij een logo. De afbeelding wordt dan volledig getoond op een witte achtergrond in plaats van passend gesneden, zodat er niets wegvalt."
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
