{
  "kind": "collectionType",
  "collectionName": "references",
  "info": {
    "singularName": "reference",
    "pluralName": "references",
    "displayName": "Referentie",
    "description": "Uitgevoerde projecten van GreenDee"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "location": {
      "type": "string",
      "required": true
    },
    "capacity": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": ["Energiehandel", "Netcongestie", "Energie-optimalisatie"],
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
